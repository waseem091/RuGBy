{
  "name": "rugby",
  "version": "0.1.0",
  "description": "Rendered-color auditor for the web: pixel-sampled contrast checks (WCAG 2 + APCA) and design-token drift detection on real pages.",
  "keywords": [
    "accessibility",
    "a11y",
    "contrast",
    "wcag",
    "apca",
    "design-tokens",
    "design-system",
    "color",
    "playwright",
    "axe",
    "audit",
    "mcp"
  ],
  "homepage": "https://github.com/waseem091/RuGBy#readme",
  "bugs": {
    "url": "https://github.com/waseem091/RuGBy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waseem091/RuGBy.git"
  },
  "license": "MIT",
  "author": "Muhammad Waseem",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rugby": "dist/cli.js",
    "rugby-mcp": "dist/mcp/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs/report-schema.md",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"for (const f of ['dist/cli.js', 'dist/mcp/bin.js']) require('fs').chmodSync(f, 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixture": "node dist/cli.js fixture",
    "test:exhaustive": "RUGBY_EXHAUSTIVE=1 vitest run test/color/exhaustive.test.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "14.0.3",
    "playwright-core": "1.56.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/culori": "4.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "culori": "4.0.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
